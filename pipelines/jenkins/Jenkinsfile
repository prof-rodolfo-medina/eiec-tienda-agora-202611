// SEMANA 5 · Tema 7 · El mismo pipeline de la fase de commit, ahora en Jenkins.
// Sintaxis declarativa. Úsalo con un trabajo "Pipeline script from SCM" que apunte a tu fork
// y cuyo "Script Path" sea: pipelines/jenkins/Jenkinsfile
//
// Requiere un agente con python3, python3-venv y make (la imagen de
// pipelines/jenkins/Dockerfile ya los incluye) y los plugins recomendados + JUnit.

pipeline {
    agent { label 'python' }   // el agente debe tener la etiqueta "python" (o usa: agent any)

    options {
        timeout(time: 15, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timestamps()
    }

    triggers {
        // Sin IP pública no hay webhook: se consulta el repositorio cada ~5 minutos.
        pollSCM('H/5 * * * *')
    }

    environment {
        APP_ENV = 'ci'
        VENV = "${WORKSPACE}/.venv"
    }

    stages {
        stage('Preparar entorno') {
            steps {
                sh '''
                    python3 -m venv "$VENV"
                    . "$VENV/bin/activate"
                    pip install -q -r requirements-dev.txt
                '''
            }
        }

        stage('Análisis estático') {
            steps {
                sh '. "$VENV/bin/activate" && flake8 app tests'
            }
        }

        stage('Pruebas unitarias') {
            steps {
                sh '. "$VENV/bin/activate" && python -m pytest -q -m unit --junitxml=reports/unit.xml'
            }
        }

        stage('Pruebas de API') {
            steps {
                sh '''
                    . "$VENV/bin/activate"
                    python -m pytest -q -m api --junitxml=reports/api.xml \
                      --cov=app --cov-report=xml:reports/coverage.xml
                '''
            }
        }

        stage('Empaquetar') {
            // Solo la rama principal produce un artefacto. En un trabajo "Pipeline" simple
            // GIT_BRANCH vale "origin/main"; en uno "Multibranch" podrías usar: when { branch 'main' }
            when { expression { (env.GIT_BRANCH ?: 'main').endsWith('main') } }
            steps {
                sh '''
                    SHA=$(git rev-parse HEAD)
                    SHORT=$(git rev-parse --short HEAD)
                    echo "{\\"version\\": \\"0.1.0+${SHORT}\\", \\"commit\\": \\"${SHA}\\"}" > app/build_info.json
                    tar czf "agora-${SHORT}.tgz" app requirements.txt
                '''
                archiveArtifacts artifacts: 'agora-*.tgz', fingerprint: true
            }
        }
    }

    post {
        always {
            junit allowEmptyResults: true, testResults: 'reports/*.xml'
            archiveArtifacts artifacts: 'reports/**', allowEmptyArchive: true
        }
        failure {
            echo 'El pipeline se detuvo: revisa la etapa en rojo y el informe de pruebas.'
        }
    }
}
